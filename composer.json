{
    "name": "soportic/polyglot-ai",
    "description": "Traducción multilingüe para WordPress con motor de IA.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/wordpress-stubs": "^6.6",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "PolyglotAI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PolyglotAI\\Tests\\": "tests/unit/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.1"
        }
    },
    "scripts": {
        "html-api": "bash tests/bin/install-html-api.sh",
        "test": [
            "@html-api",
            "phpunit"
        ],
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "phpstan": "bash tools/install-phpstan.sh && php tools/phpstan.phar analyse --memory-limit=1G",
        "test:install": "bash tests/bin/install-wp-tests.sh",
        "test:integration": "phpunit -c phpunit-integration.xml.dist"
    }
}
