{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pgai/language-switcher",
	"title": "Selector de idioma",
	"category": "widgets",
	"icon": "translation",
	"description": "Enlaces a esta misma página en los demás idiomas del sitio.",
	"textdomain": "polyglot-ai",
	"supports": {
		"html": false,
		"align": [ "left", "center", "right" ]
	},
	"attributes": {
		"display": {
			"type": "string",
			"default": "name"
		},
		"layout": {
			"type": "string",
			"default": "list"
		},
		"hideCurrent": {
			"type": "boolean",
			"default": false
		}
	},
	"editorScript": "file:../../build/block.js",
	"style": "file:../../build/style-switcher.css"
}
